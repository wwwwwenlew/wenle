.about-project-link small {
  color: var(--shell-muted);
  font-size: 0.76rem;
}

.about-contact {
  margin: 72px 0 12px;
  padding: 48px;
  border-radius: 20px;
  background: var(--shell-ink);
  color: #fff;
}

.about-contact h2 {
  max-width: 620px;
  margin: 0 0 28px !important;
  color: #fff;
  font-size: clamp(1.65rem, 3vw, 2.4rem);
  font-weight: 800 !important;
  line-height: 1.25;
  letter-spacing: -0.04em;
}

.about-contact a {
  color: #aebaff !important;
  font: 700 0.82rem/1.5 Consolas, monospace;
}

/* Fluid 暗色模式下沿用同一结构，仅替换设计变量。 */
html[data-user-color-scheme='dark'] body.is-subpage {
  --shell-bg: #0e1320;
  --shell-surface: #151c2b;
  --shell-surface-soft: #111827;
  --shell-ink: #eef2ff;
  --shell-muted: #9ba6bc;
  --shell-line: rgba(223, 230, 255, 0.11);
  --shell-accent: #8093ff;
  --shell-accent-soft: rgba(101, 122, 255, 0.14);
  background: var(--shell-bg);
}

html[data-user-color-scheme='dark'] body.is-projects-page {
  --project-ink: var(--shell-ink);
  --project-muted: var(--shell-muted);
  --project-line: var(--shell-line);
  --project-accent: var(--shell-accent);
  --project-accent-soft: var(--shell-accent-soft);
  background: var(--shell-bg);
}

html[data-user-color-scheme='dark'] body.is-subpage .header-inner {
  background:
    radial-gradient(circle at 76% 14%, rgba(99, 121, 255, 0.18), transparent 27%),
    linear-gradient(180deg, #111827 0%, var(--shell-bg) 100%);
}

html[data-user-color-scheme='dark'] body.is-subpage .navbar {
  background: rgba(14, 19, 32, 0.86) !important;
}

html[data-user-color-scheme='dark'] body.is-subpage:not(.is-projects-page):not(.is-post-page) #board,
html[data-user-color-scheme='dark'] body.is-projects-page #board,
html[data-user-color-scheme='dark'] body.is-post-page #board,
html[data-user-color-scheme='dark'] .project-mini-card,
html[data-user-color-scheme='dark'] .about-focus-grid article {
  background: var(--shell-surface) !important;
}

@media (max-width: 767px) {
  body.is-subpage:not(.is-projects-page) .header-inner {
    height: 220px !important;
  }

  body.is-subpage:not(.is-projects-page) #banner .mask {
    padding-bottom: 38px;
  }

  body.is-subpage:not(.is-projects-page) .banner-text {
    width: calc(100% - 32px);
  }

  body.is-article-list-page #board > .container > .row > [class*='col-'] {
    padding: 0 28px;
  }

  body.is-subpage.is-post-page .header-inner {
    height: 56px !important;
  }

  body.is-post-page #board-ctn {
    width: calc(100% - 24px);
  }

  body.is-post-page #board {
    padding-top: 42px;
    border-radius: 18px;
  }

  body.is-post-page #seo-header {
    margin-bottom: 30px;
    padding-bottom: 24px;
  }

  body.is-post-page .post-content {
    padding-right: 28px;
    padding-left: 28px;
  }

  .about-focus-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 575px) {
  body.is-subpage:not(.is-projects-page):not(.is-post-page) #board {
    border-right: 0;
    border-left: 0;
    border-radius: 0;
  }

  body.is-article-list-page #board > .container > .row > [class*='col-'] {
    padding: 0 20px;
  }

  body.is-article-list-page .list-group-item {
    grid-template-columns: 62px minmax(0, 1fr) 18px;
    gap: 10px;
    min-height: 68px;
  }

  body.is-post-page .post-content {
    padding-right: 20px;
    padding-left: 20px;
  }

  .about-lead {
    padding: 36px 0 56px;
  }

  .about-actions {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }

  .about-focus,
  .about-practice {
    padding: 56px 0;
  }

  .about-section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }

  .about-contact {
    margin-top: 56px;
    padding: 34px 26px;
  }
}
